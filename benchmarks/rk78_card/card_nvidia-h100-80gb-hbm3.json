 "fit": {
  "arms": {
   "eagle_graph": "the attempt is per-sample scalar code (22 lines with its launch; the kernel finishes its own samples), one kernel per attempt looped on the device: 95.4 ms.",
   "eagle_graph_compact": "the same kernel launched over the live samples only: 117 ms; the plain graph takes 0.819\u00d7 as long.",
   "eagle_graph_reorder": "adds the occasional reorder of the planes: 108 ms; the compacted graph takes 1.08\u00d7 as long.",
   "eagle_graph_persist": "the plain (not active-set) attempt kernel, forced through hawk's persist entry: one launch, no graph, no map, no policy kernel -- a grid of SMs blocks of 256 lanes steals the next unfinished sample off a counter when their own finishes: 43.7 ms; the eagle graph takes 2.18\u00d7 as long.",
   "eagle_simulate": "the same kernel through eagle.simulate, its state and parameters by name (21 lines with the kernel): 43.6 ms; the eagle graph takes 2.19\u00d7 as long.",
   "cupy_masked": "array code in the NumPy style (25 lines), the control flow as masks over the batch: 9.06 s.",
   "torch_masked": "the same array formulation in PyTorch (27 lines), running where a PyTorch model already runs: 8.61 s.",
   "torch_graphed": "records 16 attempts as a CUDA graph and replays them, removing per-kernel launch cost: 7.17 s; eager PyTorch takes 1.2\u00d7 as long.",
   "jax_vmap": "writes the per-sample loop directly (25 lines) and compiles the whole batch into one executable: 1.11 s.",
   "warp_kernel": "an explicit per-thread loop in a Python-embedded kernel language (74 lines, its own stages): 101 ms.",
   "eagle_cpu": "the same hawk kernel on the host's cores, no GPU needed: 6.51 s."
  }
 },
